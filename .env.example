# Copy to .env and fill in. Never commit .env (it's gitignored).

# --- Database -------------------------------------------------------------
# Pooled connection used by the running app.
#   Supabase: Dashboard → Connect → "Transaction pooler" (port 6543), append ?pgbouncer=true
#   Local Docker (docker compose up -d): postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/smart_content_curator
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct/session connection used by `prisma migrate` (can't run through pgbouncer).
#   Supabase: Dashboard → Connect → "Session pooler" (port 5432)
#   Local Docker: same value as DATABASE_URL
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Required only for the local Docker Postgres service. Use a local value and never commit .env.
POSTGRES_PASSWORD="YOUR_LOCAL_PASSWORD"

# --- AI enrichment (Google Gemini) ---------------------------------------
# Server-side only. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional. Defaults to gemini-3.5-flash-lite (cheap and fast; plenty for 40-80 word summaries).
GEMINI_MODEL="gemini-3.5-flash-lite"
# Optional. Tried only when the primary model returns 503 (overloaded). Leave empty to disable.
GEMINI_FALLBACK_MODEL=""

# --- App --------------------------------------------------------------------
# Public base URL: used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
