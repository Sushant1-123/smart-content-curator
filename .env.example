# --- Database -----------------------------------------------------------
# Postgres connection string. Works with Supabase, Neon, Railway, RDS, etc.
DATABASE_URL="postgresql://user:password@localhost:5432/smart_content_curator?schema=public"

# --- AI enrichment --------------------------------------------------------
# Anthropic API key used to generate summaries + tags for saved items.
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"
# Model used for enrichment. Haiku is fast/cheap and plenty for short
# summaries + tags; swap to a stronger model if you want richer output.
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

# --- App ------------------------------------------------------------------
# Public base URL, used to build absolute URLs for sitemap.xml, robots.txt
# and Open Graph tags on individual item pages.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
